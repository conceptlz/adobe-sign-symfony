{
    "name": "conceptlz/adobe-sign-symfony",
    "description": "Symfony bundle for conceptlz/adobe-sign (Adobe Acrobat Sign REST API v6).",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "adobe",
        "acrobat sign",
        "symfony",
        "bundle",
        "esignature"
    ],
    "authors": [
        {
            "name": "Conceptualize",
            "email": "info@conceptualize.ae"
        }
    ],
    "support": {
        "issues": "https://github.com/conceptlz/adobe-sign/issues",
        "source": "https://github.com/conceptlz/adobe-sign-symfony"
    },
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "conceptlz/adobe-sign": "^0.4",
        "psr/cache": "^2.0 || ^3.0",
        "symfony/cache": "^7.4 || ^8.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/event-dispatcher": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.3",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/messenger": "^7.4 || ^8.0",
        "symfony/security-core": "^7.4 || ^8.0"
    },
    "suggest": {
        "doctrine/dbal": "Store OAuth tokens in your database (oauth.token_store: doctrine)",
        "symfony/messenger": "Handle webhook notifications asynchronously (webhooks.messenger)",
        "symfony/security-bundle": "OAuth connections keyed by the signed-in user",
        "symfony/http-client": "PSR-18 HTTP client (with nyholm/psr7) if your app has none yet"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../adobe-sign",
            "options": {
                "symlink": true,
                "versions": {
                    "conceptlz/adobe-sign": "0.4.x-dev"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Conceptlz\\AdobeSign\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Conceptlz\\AdobeSign\\Symfony\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.4.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
